{% extends 'base.html.twig' %}

{% block title %}Hello PracticeCodeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h3>Practice Code</h3>

    <h4 style="margin-bottom: 5px;">Ransom Note</h4>
    {{ ransom == 1 ? "true" : "false" }} 

    <h4 style="margin-bottom: 5px;">Max Profit</h4>
    {{ maxProfit }} 

    <h4 style="margin-bottom: 5px;">Max Difference</h4>
    {{ maxDiff }} 

    <h4 style="margin-bottom: 5px;">Remove Duplicates</h4>
    {{ removeDuplicates }} 
</div>
{% endblock %}
