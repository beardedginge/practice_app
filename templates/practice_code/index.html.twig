{% extends 'base.html.twig' %}

{% block title %}Hello PracticeCodeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h3>Practice Code</h3>

    <h4 style="margin-bottom: 5px;">Ransom Note</h4>
    {{ ransom == 1 ? "true" : "false" }} 

    <h4 style="margin-bottom: 5px;">Max Profit</h4>
    {{ maxProfit }} 

    <h4 style="margin-bottom: 5px;">Max Difference</h4>
    {{ maxDiff }} 

    <h4 style="margin-bottom: 5px;">Remove Duplicates</h4>
    {{ removeDuplicates }} 

    <h4 style="margin-bottom: 5px;">Sorted Grades</h4>
    {{ sortGrades }}

    <h4 style="margin-bottom: 5px;">Palindrome Number</h4>
    {{ palindromeNum == 1 ? "true" : "false" }}

    <h4 style="margin-bottom: 5px;">Array</h4>
    {# {{treeArray}} #}

    <ul>
        {% for tree in treeArray %}
        <li>
            {{tree.name}} - {{tree.completed == 1 ? 'true' : 'false'}} - {{tree.depth}}

            {% if task['subtasks'] is defined %}
            <ul>
                {% for subtask in tree.subtasks %}
                <li>{{ subtask.name}} - {{subtask.completed == 1 ? 'true' : 'false'}} - {{subtask.depth}}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </li>
        {% endfor %}
    </ul>

    <h4 style="margin-bottom: 5px;">Orders</h4>    
    <ul>
        {% for name,order in orders %}
        <li>
            {{ name }} - {{ order }}
        </li>
        {% endfor %}
    </ul>

    <h4 style="margin-bottom: 5px;">ApiResponse</h4>    
    {# <ul>
        {% for user_id, name in apiResponse %}
        <li>
            {{ user_id }} => {{name}}
        </li>
        {% endfor %}
    </ul> #}

    <h4 style="margin-bottom: 5px;">ApiResponse2</h4>    
    <ul>
        {% for id, user in apiResponse %}
            <li>
                {{ user.full_name }} - {{ user.total_spent }}
            </li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
